# Swarm service configuration — copy to .env and adjust, or export these vars.
# Every value has a safe default; with none of them set the service runs the
# pipeline + swarm memory and simply does not send notifications.

# --- NATS message bus ---
# The swarm subscribes to system.pipeline on NATS. Point at your own broker.
NATS_URL=nats://127.0.0.1:4222
NATS_USER=nexus
NATS_PASS=

# --- Discord notifications (OPT-IN) ---
# Leave SWARM_DISCORD_ENABLED=0 (default) for a non-notifying install/test path.
# Set to 1 and provide a token file + channel id to enable notifications.
SWARM_DISCORD_ENABLED=0
# Path to a file containing the Discord bot token (default: ~/.discord_bot_token)
SWARM_DISCORD_TOKEN_FILE=~/.discord_bot_token
# Numeric Discord channel id to post results to.
SWARM_DISCORD_CHANNEL=

# --- Local model (pipeline agents) ---
# The pipeline (pipeline.py) calls an Ollama-compatible endpoint. Override if not local.
OLLAMA_URL=http://127.0.0.1:11434
# Model tag the pipeline agents request from Ollama.
SWARM_MODEL=qwen2.5-coder:1.5b
